# Railway 환경 변수 설정 예시
# Railway 대시보드에서 이 값들을 설정하세요

# ============ 필수 설정 ============

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# AI APIs (최소 하나는 필요)
OPENAI_API_KEY=sk-...
# 또는
GEMINI_API_KEY=...

# Serper (트렌드 검색용)
SERPER_API_KEY=...

# ============ Railway Redis (자동 제공) ============
# Railway에서 Redis 플러그인 추가시 자동 설정됨
# REDIS_URL=redis://default:password@host:port

# ============ Cloudflare (선택사항) ============

# KV Storage (장기 백업용)
CF_ACCOUNT_ID=your_account_id
CF_API_TOKEN=your_api_token
KV_NAMESPACE_ID=your_kv_namespace

# R2 Storage (파일 저장용)
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=meme-launch-data

# ============ Four.meme (토큰 생성시 필요) ============
FOUR_MEME_API_URL=https://four.meme/meme-api
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# ============ 옵션 설정 ============

# Rate Limiting
DAILY_LIMIT=5
CACHE_TTL=600

# Logging
LOG_LEVEL=INFO
